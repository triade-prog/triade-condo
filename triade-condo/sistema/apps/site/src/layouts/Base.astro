---
import "../styles/site.css";
import "../styles/paginas.css";
import "../styles/aberturas.css";
import Cabecalho from "../components/Cabecalho.astro";
import Rodape from "../components/Rodape.astro";

// `lavanda`: o topo da página é lavanda e o cabeçalho fica translúcido sobre ele.
interface Props { titulo: string; descricao: string; atual?: string; semIndice?: boolean; lavanda?: boolean; }
const { titulo, descricao, atual, semIndice = false, lavanda = false } = Astro.props;
const tituloCompleto = titulo === "TRÍADE Condo" ? titulo : `${titulo} · TRÍADE Condo`;
const canonico = new URL(Astro.url.pathname, Astro.site);
const imagem = new URL("/og.png", Astro.site);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("com-js");</script>
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonico} />
    {semIndice && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#5808cc" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="TRÍADE Condo" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonico} />
    <meta property="og:image" content={imagem} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Verificação do domínio no Facebook (Meta Business), pedida pela Carolina em 26/10/2026. -->
    <meta name="facebook-domain-verification" content="izvsyquqhlsogfhwsevh6p0ddzb2sv" />
    {import.meta.env.PROD && <script is:inline defer src="/_vercel/insights/script.js"></script>}
  </head>
  <body class:list={[lavanda && "topo-lavanda"]}>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Cabecalho atual={atual} />
    <main id="conteudo">
      <slot />
    </main>
    <Rodape />
    <script>
      // As seções entram suavemente quando chegam à tela. Quem pede menos movimento vê tudo parado.
      if (matchMedia("(prefers-reduced-motion: no-preference)").matches && "IntersectionObserver" in window) {
        const alvos = document.querySelectorAll<HTMLElement>("main section:not(:first-child) .wrap > :not(.rolagem):not(.palco-fixo)");
        const io = new IntersectionObserver((es) => es.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add("visivel"); io.unobserve(e.target); }
        }), { rootMargin: "0px 0px -8% 0px" });
        alvos.forEach((a) => { if (a.getBoundingClientRect().top > innerHeight) { a.classList.add("revela"); io.observe(a); } });
      }
    </script>
  </body>
</html>
