---
import "../styles/site.css";
import Cabecalho from "../components/Cabecalho.astro";
import Rodape from "../components/Rodape.astro";

interface Props { titulo: string; descricao: string; atual?: string; semIndice?: boolean; }
const { titulo, descricao, atual, semIndice = false } = Astro.props;
const tituloCompleto = titulo === "TRÍADE Condo" ? titulo : `${titulo} · TRÍADE Condo`;
const canonico = new URL(Astro.url.pathname, Astro.site);
const imagem = new URL("/og.png", Astro.site);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("com-js");</script>
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonico} />
    {semIndice && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#5808cc" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="TRÍADE Condo" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonico} />
    <meta property="og:image" content={imagem} />
    <meta name="twitter:card" content="summary_large_image" />
    {import.meta.env.PROD && <script is:inline defer src="/_vercel/insights/script.js"></script>}
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Cabecalho atual={atual} />
    <main id="conteudo">
      <slot />
    </main>
    <Rodape />
  </body>
</html>
