---
import Base from "../layouts/Base.astro";
import CenaPedido from "../components/CenaPedido.astro";
import Destaque from "../components/Destaque.astro";
import FaixaFinal from "../components/FaixaFinal.astro";
import InicioPainel from "../components/InicioPainel.astro";
import Olho from "../components/Olho.astro";
import TelaModulo from "../components/TelaModulo.astro";
import { icones } from "../dados/icones";
import { plataforma } from "../dados/vitrine";
---
<Base titulo="Plataforma" atual="/plataforma" lavanda descricao="Atendimento, comunicação, operações e indicadores do condomínio num painel só. O morador continua no WhatsApp; o síndico acompanha tudo pelo painel.">
<section class="pag-topo com-imagem com-painel">
  <span class="cor-cunha deco-a" aria-hidden="true"></span><span class="cor-cunha deco-b" aria-hidden="true"></span><span class="cor-cunha deco-c" aria-hidden="true"></span>
  <div class="wrap">
    <div class="pag-topo-texto">
      <h1 class="titulo-g">Um painel para o que acontece <Destaque>no prédio</Destaque></h1>
      <p class="lead2">Atendimento, comunicação, operações e indicadores no mesmo lugar. O morador continua no WhatsApp; o síndico acompanha tudo por aqui.</p>
    </div>
    <figure class="topo-painel">
      <InicioPainel perfil="morador" grande />
      <figcaption><span class="so-pc">Início do painel</span><span class="so-cel">Painel</span> do síndico · Dados ilustrativos</figcaption>
    </figure>
  </div>
</section>

{plataforma.map((bloco, i) => (
  <section class:list={["modulo2 ancora", i % 2 === 1 && "inv lav"]} id={bloco.id} aria-labelledby={`titulo-${bloco.id}`}>
    <div class="wrap">
      <div class="modulo2-txt">
        <Olho>{bloco.olho}</Olho>
        <h2 class="titulo-g" id={`titulo-${bloco.id}`}>{bloco.titulo} <Destaque semTraco quebra>{bloco.destaque}</Destaque></h2>
        <p class="lead2">{bloco.lead}</p>
        <ul class="recursos">{bloco.itens.map((t) => <li><span class="lad" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icones[t.icone]} /></span><span><b>{t.titulo}</b><small>{t.texto}</small></span></li>)}</ul>
      </div>
      <div>
        <div class="modulo2-v" aria-hidden="true">{bloco.id === "atendimento" ? <CenaPedido etapa={2} /> : <TelaModulo id={bloco.id} />}</div>
        <p class="modulo2-nota">Dados ilustrativos.</p>
      </div>
    </div>
  </section>
))}
<FaixaFinal />
</Base>

