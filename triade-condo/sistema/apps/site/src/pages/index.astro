---
import Base from "../layouts/Base.astro";
import GenteFaixa from "../components/GenteFaixa.astro";
import Destaque from "../components/Destaque.astro";
import Etapas from "../components/Etapas.astro";
import FaixaFinal from "../components/FaixaFinal.astro";
import { protocolo } from "../dados/vitrine";

const grupo = [
  { quem: "Marcos · 104", texto: "Bom dia, vizinhos!" },
  { quem: "Lúcia · 201", texto: "Alguém achou um molho de chaves no salão?" },
  { quem: "Pedro · 503", texto: "[figurinha]" },
  { quem: "Ana · 302", texto: "O vazamento da garagem voltou, perto da vaga 12. Já é a terceira vez.", perdido: true },
  { quem: "Rita · 402", texto: "Quem está fazendo barulho às 23h?" },
  { quem: "Marcos · 104", texto: "Bom dia de novo kkk" },
  { quem: "Joana · 101", texto: "Tem foto do cachorro perdido?" },
  { quem: "Pedro · 503", texto: "Isso devia ir pro síndico, não?" },
];
const hoje = ["Quem viu primeiro resolve, se alguém viu", "O morador não sabe se alguém está cuidando", "O prédio inteiro lê a reclamação", "Trocou o síndico, a história fica no celular dele"];
const comTriade = ["Cada pedido tem um responsável", "Data combinada para dar notícia; venceu, o sistema avisa", "Só o morador e quem atende veem a conversa", "A história do pedido fica no prédio, com autor e data"];
---
<Base titulo="TRÍADE Condo" lavanda descricao="O morador pede pelo WhatsApp do condomínio. A TRÍADE registra, dá protocolo e acompanha quem resolve, quando dá retorno e como cada caso terminou. Para síndicos em Brasília e no DF.">

<section class="hero2 ancora">
  <span class="cor-cunha deco-a" aria-hidden="true"></span><span class="cor-cunha deco-b" aria-hidden="true"></span><span class="cor-cunha deco-c" aria-hidden="true"></span>
  <div class="wrap">
    <div>
      <h1>Nenhum pedido do seu prédio fica <Destaque>sem resposta</Destaque></h1>
      <p class="lead2">O morador escreve no WhatsApp do condomínio. A TRÍADE dá um número ao pedido, um responsável e uma data para dar notícia. Você acompanha tudo por um painel.</p>
      <div class="acoes"><a href="#pedir" class="botao primario">Agendar demonstração</a><a href="#etapas" class="botao claro">Ver um pedido do início ao fim</a></div>
    </div>
    <div class="palco-predio" role="img" aria-label={`O prédio da TRÍADE. Ao lado, um exemplo: a moradora escreve no WhatsApp, recebe o protocolo ${protocolo} com a data do retorno, e o pedido aparece no painel com responsável e prazo.`}>
      <img class="predio" src="/predio-triade-1400.webp" srcset="/predio-triade-800.webp 800w, /predio-triade-1400.webp 1400w" sizes="(max-width: 1000px) 100vw, 640px" width="1400" height="956" fetchpriority="high" alt="" />
      <div class="pf-cartao pf-msg s1" aria-hidden="true"><small>Ana · apto 302</small><span>O vazamento da garagem voltou, perto da vaga 12.</span></div>
      <div class="pf-cartao pf-resp s2" aria-hidden="true"><span>Registrado: pedido <b class="prot">{protocolo}</b>. Você terá notícia até <b>sexta, 12h</b>.</span></div>
      <div class="pf-cartao pf-ficha s3" aria-hidden="true">
        <div class="app-pilulas"><span class="pil cinza">Manutenção</span><span class="pil violeta">Em andamento</span></div>
        <p class="app-titulo">Vazamento na garagem, vaga 12</p>
        <div class="app-linha"><span>Responsável</span><b>Carlos, síndico</b></div>
        <div class="app-linha"><span>Retorno ao morador</span><b style="color:var(--ok)">sex 23/10, 12:00</b></div>
      </div>
    </div>
  </div>
  <div class="wrap hero-fatos">
    <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19.2L4 20z" /></svg>O morador usa o WhatsApp que já tem</span>
    <span><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8M12 17v4" /></svg>O síndico responde por um painel</span>
    <span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.2" /><path d="M3 20a6 6 0 0 1 12 0" /><path d="M16 4.5a3 3 0 0 1 0 6M21 20a5.5 5.5 0 0 0-4-5.3" /></svg>Implantação presencial em Brasília e no DF</span>
  </div>
</section>

<section class="faixa-branca ancora" style="position:relative;overflow:hidden">
  <div class="wrap secao2">
    <h2 class="titulo-g" style="max-width:15em">No grupo do prédio, o pedido some. Na TRÍADE, ele <Destaque>ganha número</Destaque>.</h2>
    <p class="lead2" style="margin-top:18px">Pedido perdido, morador sem retorno, prestador que não volta, troca de síndico sem histórico. É o que mais ouvimos de quem cuida de prédio sem administradora.</p>
    <div class="versus-abas" role="tablist" aria-label="Comparar">
      <button type="button" role="tab" id="aba-hoje" aria-controls="lado-hoje" aria-selected="true" data-lado="hoje">Hoje</button>
      <button type="button" role="tab" id="aba-triade" aria-controls="lado-triade" aria-selected="false" tabindex="-1" data-lado="triade">Com a TRÍADE</button>
    </div>
    <div class="versus ancora">
      <div class="lado-v grupo atual" id="lado-hoje">
        <div class="vs-cab"><span class="vs-rot ruim">Hoje</span><h3>Grupo de WhatsApp e planilha</h3></div>
        <div class="chat-grupo" role="img" aria-label="Exemplo de grupo de moradores em que o pedido da Ana se perde entre outras mensagens">
          <div class="cab" aria-hidden="true"><span class="avatar" style="width:28px;height:28px;font-size:10px;background:#9184aa">RI</span><div><b>Moradores Residencial Ipê</b><small>87 participantes</small></div></div>
          {grupo.map((m) => <div class:list={["bg", m.perdido && "perdido"]} aria-hidden="true"><b>{m.quem}</b>{m.texto}</div>)}
          <span class="etq-perdido" aria-hidden="true">O pedido da Ana, soterrado em 40 mensagens</span>
        </div>
        <ul class="lista-vs">{hoje.map((t) => <li><span class="ico-x" aria-hidden="true">×</span><span>{t}</span></li>)}</ul>
      </div>
      <span class="vs-meio" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
      <div class="lado-v nosso" id="lado-triade">
        <div class="vs-cab"><span class="vs-rot bom">Com a TRÍADE</span><h3>Conversa individual, com protocolo</h3></div>
        <div class="chat-nosso" role="img" aria-label={`Conversa individual da moradora com o condomínio: o pedido ${protocolo} registrado, com responsável e data de retorno`}>
          <div class="balao morador" aria-hidden="true">O vazamento da garagem voltou, perto da vaga 12.<span class="hora">22:41</span></div>
          <div class="balao condo" aria-hidden="true">Registrado: pedido <b>{protocolo}</b>. Responsável: Carlos, síndico. Você terá notícia até <b>sexta, 12h</b>.<span class="hora">22:41</span></div>
          <div class="balao condo" aria-hidden="true">Atualização do <b>{protocolo}</b>: a Hidráulica Souza vem segunda de manhã.<span class="hora">sex 11:52</span></div>
        </div>
        <ul class="lista-vs">{comTriade.map((t) => <li><span class="ico-v" aria-hidden="true">✓</span><span>{t}</span></li>)}</ul>
      </div>
    </div>
    <div class="virada2"><p>Enquanto o pedido some no grupo, a cobrança cai em você.</p><a href="#etapas" class="botao primario botao-seta">Ver como a TRÍADE resolve<span class="seta-bola" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M6 13l6 6 6-6" /></svg></span></a></div>
  </div>
</section>

<Etapas />
<GenteFaixa />
<FaixaFinal />
</Base>

<script>
  import { ligarAbas } from "../lib/abas";
  ligarAbas("[data-lado]", (b) => `lado-${b.dataset.lado}`, ".lado-v");
</script>
