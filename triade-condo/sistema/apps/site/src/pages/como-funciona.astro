---
import Base from "../layouts/Base.astro";
import Olho from "../components/Olho.astro";
import FaixaFinal from "../components/FaixaFinal.astro";

const etapas = [
  { n: "01", quando: "QUI 22/10, 22:41", nome: "Registro", resumo: "A moradora manda a mensagem" },
  { n: "02", quando: "SEX 23/10, 08:10", nome: "Responsável e retorno", resumo: "O síndico decide no painel" },
  { n: "03", quando: "SEG 26/10, 11:20", nome: "Andamento", resumo: "O prestador informa pelo link" },
  { n: "04", quando: "TER 27/10, 16:05", nome: "Conclusão", resumo: "Explicada e avaliada" },
];
const conversaTopo = `<div class="conversa-topo"><span class="avatar">RI</span><div class="pilha" style="--gap:0"><b style="font-size:14px">Residencial Ipê</b><span class="suave" style="font-size:12px">WhatsApp do condomínio</span></div></div>`;
const fichaTopo = (selo: string) => `<div class="topo-claro"><div class="pilha" style="--gap:0"><span class="mono" style="font-size:12px;color:var(--tinta-suave)">PEDIDO #0412 · HIDRÁULICA · ÁREA COMUM</span><b style="font-size:17px">Vazamento na garagem, vaga 12</b></div>${selo}</div>`;
const fichaLinhas = (responsavel: string) => `<div class="linha-dado"><span class="suave">Unidade</span><b>302 · Ana · pelo WhatsApp, qui 22:41</b></div><div class="linha-dado"><span class="suave">Responsável</span><b>${responsavel}</b></div><div class="linha-dado"><span class="suave">Prioridade</span><b style="color:var(--atencao)">Alta</b></div>`;
---
<Base titulo="Como funciona" atual="/como-funciona" descricao="Um pedido do início ao fim: o que a moradora vê no WhatsApp e o que o síndico vê e decide no painel da TRÍADE Condo, etapa por etapa.">

<section class="faixa-branca" style="border-top:0">
  <span class="cunha cunha-dir" aria-hidden="true"></span>
  <div class="wrap pilha" style="--gap:20px;position:relative;padding-block:80px 56px">
    <Olho>Como funciona</Olho>
    <h1 style="max-width:760px">Um pedido, do início ao fim</h1>
    <p class="suave" style="font-size:clamp(16px,2vw,20px);max-width:680px">O vazamento da vaga 12 do Residencial Ipê, um prédio de exemplo. De um lado, o que a moradora vê no WhatsApp. Do outro, o que o síndico vê e decide no painel. Escolha a etapa: os dois lados mudam juntos.</p>
  </div>
</section>

<section class="wrap pilha" style="--gap:24px;padding-block:48px 72px">
  <div class="etapas-seletor" role="tablist" aria-label="Etapas do pedido">
    {etapas.map((e, i) => (
      <button type="button" role="tab" class="etapa-botao" id={`aba-${i + 1}`} aria-controls={`etapa-${i + 1}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
        <span class="n">{e.n} · {e.quando}</span><b>{e.nome}</b><small>{e.resumo}</small>
      </button>
    ))}
  </div>

  <!-- 1. Registro -->
  <article class="etapa-bloco" id="etapa-1" role="tabpanel" aria-labelledby="aba-1">
    <div class="etapa-cabeca"><span class="n">01 · {etapas[0].quando}</span><h2 style="font-size:24px">Registro</h2></div>
    <div class="etapa-lados">
      <div><Olho cor="cinza">O que a moradora vê</Olho>
        <div class="conversa"><Fragment set:html={conversaTopo} />
          <div class="balao morador">Boa noite, o vazamento da garagem voltou, perto da vaga 12. Tem uma poça grande.<span class="hora">qui, 22:41</span></div>
          <div class="balao condo">Boa noite, Ana (apto 302). Registrei o pedido <b>#0412</b>: vazamento na garagem, vaga 12. O síndico vê amanhã cedo e você terá notícia até <b>sexta, 12h</b>.<span class="hora">22:41</span></div>
          <div class="balao condo">Se quiser, mande uma foto do local. Ajuda o prestador.<span class="hora">22:41</span></div>
        </div>
      </div>
      <div><Olho cor="cinza">O que o síndico vê e decide</Olho>
        <div class="painel"><Fragment set:html={fichaTopo('<span class="selo violeta">Novo</span>')} />
          <div class="corpo"><Fragment set:html={fichaLinhas("Ninguém ainda")} />
            <div class="aviso"><div><b>Sem responsável.</b> <span class="suave">Pedido novo, registrado fora do horário de atendimento. O retorno ao morador já foi combinado para sexta, 12h.</span></div></div>
            <div class="linha-flex" style="--gap:8px"><span class="botao primario pequeno">Assumir</span><span class="chip">Atribuir a alguém</span><span class="chip">Ver foto</span></div>
            <p class="suave" style="font-size:13px">O que o síndico decide aqui: quem cuida e qual a prioridade. Até lá, o sistema só registra e avisa.</p>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- 2. Responsável e retorno -->
  <article class="etapa-bloco" id="etapa-2" role="tabpanel" aria-labelledby="aba-2" hidden>
    <div class="etapa-cabeca"><span class="n">02 · {etapas[1].quando}</span><h2 style="font-size:24px">Responsável e retorno</h2></div>
    <div class="etapa-lados">
      <div><Olho cor="cinza">O que a moradora vê</Olho>
        <div class="conversa"><Fragment set:html={conversaTopo} />
          <div class="balao condo">Ana, sobre o pedido <b>#0412</b>: o síndico Carlos assumiu. O prestador Hidráulica Souza vai olhar o vazamento na <b>segunda, 26/10, de manhã</b>. Te aviso quando terminar.<span class="hora">sex, 09:12</span></div>
          <div class="balao morador">Perfeito, obrigada.<span class="hora">sex, 09:30</span></div>
          <p class="suave" style="font-size:12.5px;text-align:center">A notícia chegou antes do retorno combinado (sexta, 12h).</p>
        </div>
      </div>
      <div><Olho cor="cinza">O que o síndico vê e decide</Olho>
        <div class="painel"><Fragment set:html={fichaTopo('<span class="selo violeta">Em andamento</span>')} />
          <div class="corpo"><Fragment set:html={fichaLinhas("Carlos (síndico)")} />
            <div class="grade" style="--cols:2;--cols-medio:2;--gap:10px">
              <div class="campo-dado"><span class="rotulo-dado">Próximo retorno ao morador</span><div class="linha-flex" style="--gap:8px"><b style="font-size:17px">Seg, 26/10 · 14:00</b><span class="selo verde">No prazo</span></div><span class="suave" style="font-size:12px">Compromisso de dar notícia, mesmo sem solução.</span></div>
              <div class="campo-dado"><span class="rotulo-dado">Previsão de solução</span><b style="font-size:17px">Sem previsão</b><span class="suave" style="font-size:12px">Só quando for conhecida. Nunca inventada.</span></div>
            </div>
            <div class="aviso"><div><b>Pendência real:</b> <span class="suave">aguardando visita do prestador Hidráulica Souza, segunda de manhã. Visita marcada na agenda.</span></div></div>
            <div class="linha-flex" style="--gap:8px"><span class="botao primario pequeno">Dar retorno ao morador</span><span class="chip">Marcar visita</span><span class="chip">+ Pendência</span><span class="chip">Pedir decisão</span></div>
            <p class="suave" style="font-size:13px">Se o retorno vencer, Carlos recebe alerta; se continuar vencido, o conselho ou quem ele escolher também. Nada fica esquecido.</p>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- 3. Andamento -->
  <article class="etapa-bloco" id="etapa-3" role="tabpanel" aria-labelledby="aba-3" hidden>
    <div class="etapa-cabeca"><span class="n">03 · {etapas[2].quando}</span><h2 style="font-size:24px">Andamento</h2></div>
    <div class="etapa-lados">
      <div><Olho cor="cinza">O que a moradora vê</Olho>
        <div class="conversa"><Fragment set:html={conversaTopo} />
          <div class="balao prestador"><b style="font-size:12px;color:var(--atencao);display:block">Hidráulica Souza, pelo link do pedido</b>Visita feita. Era o registro da coluna 3. A peça chega amanhã; troco na terça.<span class="hora">seg, 11:20</span></div>
          <div class="balao condo">Ana, a visita foi feita. Era o registro da coluna 3. A peça chega amanhã e a troca fica para terça. Próxima notícia: <b>terça, 18h</b>.<span class="hora">seg, 11:34</span></div>
        </div>
      </div>
      <div><Olho cor="cinza">O que o síndico vê e decide</Olho>
        <div class="painel"><Fragment set:html={fichaTopo('<span class="selo violeta">Em andamento</span>')} />
          <div class="corpo"><Fragment set:html={fichaLinhas("Carlos (síndico)")} />
            <div class="aviso verde"><div><b>Prestador informou pelo link, seg 11:20:</b> <span class="suave">visita feita; registro da coluna 3; peça chega terça; troca na terça.</span></div></div>
            <div class="campo-dado"><span class="rotulo-dado">Próximo retorno ao morador</span><div class="linha-flex" style="--gap:8px"><b style="font-size:17px">Ter, 27/10 · 18:00</b><span class="selo verde">Registrado às 11:34</span></div><span class="suave" style="font-size:12px">Retornos dados: 2 de 2 no prazo.</span></div>
            <div class="linha-flex" style="--gap:8px"><span class="botao primario pequeno">Dar retorno ao morador</span><span class="chip">Abrir manutenção ligada</span><span class="chip">Mudar etapa</span></div>
            <p class="suave" style="font-size:13px">O prestador não precisa de conta: o link vale para este pedido. O que ele escreve entra no histórico com autor e hora.</p>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- 4. Conclusão -->
  <article class="etapa-bloco" id="etapa-4" role="tabpanel" aria-labelledby="aba-4" hidden>
    <div class="etapa-cabeca"><span class="n">04 · {etapas[3].quando}</span><h2 style="font-size:24px">Conclusão</h2></div>
    <div class="etapa-lados">
      <div><Olho cor="cinza">O que a moradora vê</Olho>
        <div class="conversa"><Fragment set:html={conversaTopo} />
          <div class="balao condo">Pedido <b>#0412</b> concluído: trocado o registro da coluna 3 da garagem, pela Hidráulica Souza. Resolveu? Responda de <b>1 a 5</b>. Se o problema voltar, responda REABRIR.<span class="hora">ter, 16:05</span></div>
          <div class="balao morador">5. Ficou ótimo, obrigada!<span class="hora">ter, 16:40</span></div>
          <div class="balao condo">Obrigado pela avaliação, Ana. O registro fica no histórico do prédio.<span class="hora">ter, 16:40</span></div>
        </div>
      </div>
      <div><Olho cor="cinza">O que o síndico vê e decide</Olho>
        <div class="painel"><Fragment set:html={fichaTopo('<span class="selo verde">Concluído</span>')} />
          <div class="corpo"><Fragment set:html={fichaLinhas("Carlos (síndico)")} />
            <div class="aviso verde"><div><b>Concluído em 5 dias, ter 16:05.</b> <span class="suave">Trocado o registro da coluna 3, pela Hidráulica Souza. Foto do serviço anexada.</span></div></div>
            <div class="linha-flex" style="--gap:8px"><span class="selo verde">3 retornos, 3 no prazo</span><span class="selo verde">Avaliação 5 · Ana, 302</span><span class="chip">Reaberto? Não</span></div>
            <div class="linha-dado"><span class="suave">No histórico do prédio</span><b>Pedido, visita, prestador, custo e foto</b></div>
            <p class="suave" style="font-size:13px">O síndico prova o próprio trabalho. O próximo síndico herda o caso inteiro.</p>
          </div>
        </div>
      </div>
    </div>
  </article>

  <p class="nota-ilustrativa"><span class="mono">DADOS ILUSTRATIVOS ·</span>prédio, pessoas e horários são exemplos.</p>
</section>

<section class="faixa-branca">
  <span class="cunha cunha-esq" aria-hidden="true"></span>
  <div class="wrap secao pilha revela" style="--gap:30px;position:relative">
    <div class="titulo-secao"><Olho>Em volta do fluxo</Olho><h2>O que mais o painel organiza</h2></div>
    <ul class="grade">
      <li class="cartao topo-violeta pilha" style="--gap:8px"><h3>Comunicados e documentos</h3><p class="suave" style="font-size:15px">Avisos, atas, convenção e regimento com versões, entregues no WhatsApp, por e-mail ou no mural.</p></li>
      <li class="cartao topo-violeta pilha" style="--gap:8px"><h3>Manutenção e prestadores</h3><p class="suave" style="font-size:15px">Preventivas pela NBR 5674, vistorias, contratos e a agenda do prédio.</p></li>
      <li class="cartao topo-violeta pilha" style="--gap:8px"><h3>Memória do prédio</h3><p class="suave" style="font-size:15px">Prontuário, linha do tempo e o dossiê de passagem para o próximo síndico.</p></li>
      <li class="cartao topo-laranja pilha" style="--gap:8px"><h3>Moradores e unidades</h3><p class="suave" style="font-size:15px">Quem mora onde, quem recebe o quê, sem senha para ninguém.</p></li>
      <li class="cartao topo-laranja pilha" style="--gap:8px"><h3>Enquetes e assembleias</h3><p class="suave" style="font-size:15px">Convocação, votação simples e registro do que foi decidido.</p></li>
      <li class="cartao topo-laranja pilha" style="--gap:8px"><h3>Indicadores</h3><p class="suave" style="font-size:15px">Retornos no prazo, reaberturas e tempo de conclusão, para mostrar na assembleia.</p></li>
    </ul>
  </div>
</section>

<FaixaFinal titulo="Quer ver isso com um pedido do seu prédio?" texto="Na demonstração, registramos um caso real do seu condomínio e acompanhamos com você até o fim." />

<script>
  // Seletor de etapas (padrão de abas do WAI-ARIA): setas, Home e End movem entre as etapas.
  const abas = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const mostrar = (alvo: HTMLButtonElement, focar = false) => {
    for (const aba of abas) {
      const ativa = aba === alvo;
      aba.setAttribute("aria-selected", String(ativa));
      aba.tabIndex = ativa ? 0 : -1;
      const painel = document.getElementById(aba.getAttribute("aria-controls") ?? "");
      if (painel) {
        painel.hidden = !ativa;
        if (ativa) { painel.classList.remove("troca"); void painel.offsetWidth; painel.classList.add("troca"); }
      }
    }
    if (focar) alvo.focus();
  };
  abas.forEach((aba, i) => {
    aba.addEventListener("click", () => mostrar(aba));
    aba.addEventListener("keydown", (ev) => {
      const ir = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: abas.length - 1 }[ev.key];
      if (ir === undefined) return;
      ev.preventDefault();
      mostrar(abas[(ir + abas.length) % abas.length], true);
    });
  });
</script>
</Base>
