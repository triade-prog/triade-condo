---
import Base from "../layouts/Base.astro";
import Olho from "../components/Olho.astro";
import FormularioDemonstracao from "../components/FormularioDemonstracao.astro";
import { cidade, duracaoDemonstracao, horarioAtendimento, linkWhatsapp, promessaRetorno, whatsappLegivel } from "../dados/empresa";
const zap = linkWhatsapp("Olá! Quero conhecer a TRÍADE Condo.");
---
<Base titulo="Agendar demonstração" atual="/demonstracao" descricao={`Peça uma demonstração da TRÍADE Condo com um pedido do seu prédio. Quatro campos; respondemos pelo WhatsApp ${promessaRetorno}.`}>

<section class="faixa-branca" style="border-top:0">
  <span class="cunha cunha-dir" aria-hidden="true"></span>
  <div class="wrap pilha" style="--gap:24px;position:relative;padding-block:var(--secao-ritmo-curto)">
    <Olho>Demonstração</Olho>
    <h1 style="max-width:760px">Veja o sistema com um pedido do seu prédio</h1>
    <p class="suave" style="font-size:clamp(16px,2vw,20px);max-width:680px">Quatro campos. Guardamos o seu pedido, confirmamos o recebimento na hora e respondemos pelo WhatsApp {promessaRetorno} para marcar a demonstração.</p>
  </div>
</section>

<section class="wrap lado-a-lado" style="--colunas:minmax(0,3fr) minmax(0,2fr);--gap:48px;padding-block:var(--secao-ritmo-curto) var(--secao-ritmo)">
  <FormularioDemonstracao />
  <div class="pilha" style="--gap:16px">
    <div class="cartao pilha">
      <Olho>O que acontece depois</Olho>
      <ol class="passos-depois">
        <li><span class="mono">01</span><span><b>Agora:</b> confirmamos o recebimento nesta página.</span></li>
        <li><span class="mono">02</span><span><b>{promessaRetorno[0].toUpperCase() + promessaRetorno.slice(1)}:</b> respondemos pelo WhatsApp e marcamos {duracaoDemonstracao}.</span></li>
        <li><span class="mono">03</span><span><b>Na demonstração:</b> registramos um pedido real do seu prédio e você vê o painel pelo seu caso, não pelo nosso.</span></li>
        <li><span class="mono">04</span><span><b>Se fizer sentido:</b> teste assistido com os seus moradores. Sem cartão até lá.</span></li>
      </ol>
    </div>
    <div class="cartao pilha" style="--gap:12px;background:var(--violeta-50);border-color:#e6d9fb">
      {zap && <p style="font-size:16px">Prefere falar direto? O WhatsApp comercial é <a href={zap}><b>{whatsappLegivel()}</b></a>, em {horarioAtendimento}.</p>}
      <p class="suave" style="font-size:14px">A demonstração é feita pela TRÍADE, de {cidade}, por videochamada ou na reunião do condomínio. Hoje atendemos o Distrito Federal e o entorno; outras cidades, sob consulta.</p>
    </div>
  </div>
</section>
</Base>
