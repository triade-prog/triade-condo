---
import { opcoesUnidades } from "../dados/oferta";
import { linkWhatsapp, promessaRetorno } from "../dados/empresa";
const temWhatsapp = linkWhatsapp() !== null;
---
<div class="cartao formulario" id="caixa-formulario">
  <div class="alerta-erro" id="erro-geral" role="alert" hidden></div>

  <form id="form-demonstracao" method="post" action="/api/demonstracao" novalidate aria-describedby="promessa">
    <div class="pilha" style="--gap:18px">
      <div class="campo">
        <label for="nome">Seu nome <span class="obrigatorio" aria-hidden="true">*</span></label>
        <input id="nome" name="nome" required maxlength="80" autocomplete="name" placeholder="Como quer ser chamado" aria-describedby="erro-nome" />
        <span class="erro-campo" id="erro-nome"></span>
      </div>
      <div class="campo">
        <label for="whatsapp">WhatsApp <span class="obrigatorio" aria-hidden="true">*</span></label>
        <input id="whatsapp" name="whatsapp" type="tel" required inputmode="tel" autocomplete="tel" placeholder="(61) 9 0000-0000" aria-describedby="ajuda-whatsapp erro-whatsapp" />
        <span class="ajuda" id="ajuda-whatsapp">É por ele que respondemos. Não ligamos sem combinar.</span>
        <span class="erro-campo" id="erro-whatsapp"></span>
      </div>
      <div class="campo">
        <label for="condominio">Condomínio <span class="obrigatorio" aria-hidden="true">*</span></label>
        <input id="condominio" name="condominio" required maxlength="120" autocomplete="organization" placeholder="Nome e cidade" aria-describedby="erro-condominio" />
        <span class="erro-campo" id="erro-condominio"></span>
      </div>
      <div class="campo">
        <label for="unidades">Quantas unidades <span class="obrigatorio" aria-hidden="true">*</span></label>
        <select id="unidades" name="unidades" required aria-describedby="ajuda-unidades erro-unidades">
          <option value="">Escolha a faixa</option>
          {opcoesUnidades.map((o) => <option>{o}</option>)}
        </select>
        <span class="ajuda" id="ajuda-unidades">Serve para já falarmos do preço da sua faixa.</span>
        <span class="erro-campo" id="erro-unidades"></span>
      </div>
      <div class="campo">
        <label class="consentimento"><input type="checkbox" name="consentimento" id="consentimento" required aria-describedby="erro-consentimento" /><span>Autorizo o uso destes dados só para responder a este pedido, como diz a <a href="/privacidade">política de privacidade</a>. Nada de lista de e-mails. <span class="obrigatorio" aria-hidden="true">*</span></span></label>
        <span class="erro-campo" id="erro-consentimento"></span>
      </div>
      <div class="robo" aria-hidden="true"><label for="site">Não preencha</label><input id="site" name="site" tabindex="-1" autocomplete="off" /></div>
      <p class="suave" style="font-size:13px">Os campos com <span class="obrigatorio" aria-hidden="true">*</span><span class="so-leitor">asterisco</span> são obrigatórios.</p>
      <div class="linha-flex"><button type="submit" class="botao primario" id="enviar">Pedir demonstração</button></div>
      <p id="promessa" class="suave" style="font-size:13.5px">Ao enviar, você recebe a confirmação aqui mesmo. Respondemos pelo WhatsApp {promessaRetorno}.</p>
    </div>
  </form>

  <div id="confirmacao" class="pilha troca" style="--gap:16px" role="status" tabindex="-1" hidden>
    <div class="aviso verde" style="font-size:15px"><div><b id="conf-titulo">Pedido recebido.</b> <span class="suave" id="conf-texto"></span></div></div>
    {temWhatsapp && <p class="suave" style="font-size:15px">Se preferir não esperar, pode puxar a conversa agora. A mensagem já vai pronta com o nome do condomínio.</p>}
    <div class="linha-flex">
      {temWhatsapp && <a href={linkWhatsapp() ?? "#"} id="conf-whatsapp" class="botao laranja">Falar agora pelo WhatsApp</a>}
      <a href="/como-funciona" class="botao claro">Ver como funciona enquanto espera</a>
    </div>
  </div>
</div>

<script define:vars={{ promessaRetorno, base: linkWhatsapp() }}>
  const form = document.getElementById("form-demonstracao");
  const botao = document.getElementById("enviar");
  const erroGeral = document.getElementById("erro-geral");
  const campos = ["nome", "whatsapp", "condominio", "unidades", "consentimento"];
  const mensagens = {
    nome: "Escreva o seu nome.",
    whatsapp: "Falta o WhatsApp, com DDD. Sem ele não conseguimos responder.",
    condominio: "Escreva o nome do condomínio e a cidade.",
    unidades: "Escolha a faixa de unidades.",
    consentimento: "Marque a autorização para podermos responder.",
  };
  const digitos = (v) => v.replace(/\D/g, "").replace(/^0+/, "");
  const validar = () => {
    const d = new FormData(form);
    const erros = {};
    if ((d.get("nome") || "").toString().trim().length < 2) erros.nome = mensagens.nome;
    const w = digitos((d.get("whatsapp") || "").toString());
    if (!(w.length >= 10 && w.length <= 13)) erros.whatsapp = mensagens.whatsapp;
    if ((d.get("condominio") || "").toString().trim().length < 2) erros.condominio = mensagens.condominio;
    if (!d.get("unidades")) erros.unidades = mensagens.unidades;
    if (!d.get("consentimento")) erros.consentimento = mensagens.consentimento;
    return erros;
  };
  const marcar = (erros) => {
    for (const c of campos) {
      const el = document.getElementById(c);
      const msg = document.getElementById(`erro-${c}`);
      el.setAttribute("aria-invalid", erros[c] ? "true" : "false");
      msg.textContent = erros[c] || "";
    }
  };
  const mostrarErroGeral = (texto) => { erroGeral.innerHTML = texto; erroGeral.hidden = !texto; };

  // Volta do envio sem JavaScript com erro.
  const q = new URLSearchParams(location.search).get("erro");
  if (q === "envio") mostrarErroGeral("<div><b>Não conseguimos guardar o seu pedido agora.</b> Tente de novo em alguns minutos" + (base ? ', ou <a href="' + base + '">fale pelo WhatsApp</a>.' : ".") + "</div>");
  if (q === "campos") mostrarErroGeral("<div><b>Faltou algum campo.</b> Confira os campos marcados e envie de novo.</div>");

  form.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    mostrarErroGeral("");
    const erros = validar();
    marcar(erros);
    const primeiro = campos.find((c) => erros[c]);
    if (primeiro) {
      mostrarErroGeral(`<div><b>${Object.keys(erros).length === 1 ? "Falta um campo." : "Faltam alguns campos."}</b> ${erros[primeiro]}</div>`);
      document.getElementById(primeiro).focus();
      return;
    }
    const d = new FormData(form);
    const comUnidades = (u) => (/pr[ée]dios|unidades/.test(u) ? u : `${u} unidades`);
    const corpo = { nome: d.get("nome"), whatsapp: d.get("whatsapp"), condominio: d.get("condominio"), unidades: d.get("unidades"), consentimento: d.get("consentimento") === "on", site: d.get("site") };
    botao.disabled = true;
    botao.textContent = "Enviando…";
    try {
      const r = await fetch(form.action, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(corpo) });
      const res = await r.json().catch(() => ({ ok: false }));
      if (res.ok) {
        const nome = String(corpo.nome).trim().split(" ")[0];
        document.getElementById("conf-titulo").textContent = `Pedido recebido, ${nome}.`;
        document.getElementById("conf-texto").textContent = `Guardamos o seu pedido para o ${String(corpo.condominio).trim()} (${comUnidades(String(corpo.unidades))})${res.horario ? ` às ${res.horario} de hoje` : ""}. Respondemos pelo WhatsApp ${res.whatsapp || "que você informou"} ${promessaRetorno}.`;
        const zap = document.getElementById("conf-whatsapp");
        if (zap && base) zap.href = base.split("?")[0] + "?text=" + encodeURIComponent(`Olá! Acabei de pedir uma demonstração da TRÍADE Condo para o ${String(corpo.condominio).trim()} (${comUnidades(String(corpo.unidades))}).`);
        form.hidden = true;
        const conf = document.getElementById("confirmacao");
        conf.hidden = false;
        conf.focus();
        return;
      }
      if (res.erro === "campos" && res.erros) {
        marcar(res.erros);
        mostrarErroGeral("<div><b>Confira os campos marcados.</b></div>");
      } else {
        mostrarErroGeral("<div><b>Não conseguimos guardar o seu pedido agora.</b> Tente de novo em alguns minutos" + (base ? ', ou <a href="' + base + '">fale pelo WhatsApp</a>.' : ".") + "</div>");
      }
    } catch {
      mostrarErroGeral("<div><b>Sem conexão.</b> Confira a internet e tente de novo.</div>");
    }
    botao.disabled = false;
    botao.textContent = "Pedir demonstração";
  });
</script>
