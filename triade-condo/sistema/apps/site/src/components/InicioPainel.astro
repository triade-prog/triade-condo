---
// O Início do painel (Resumo do dia e a lista Agora), como o sistema mostra a cada perfil.
import BarraPainel from "./BarraPainel.astro";
import { protocolo } from "../dados/vitrine";
// grande: versão legível (letra mínima de 14px no computador) e mais baixa, usada no topo da página Plataforma;
// troca o texto da busca por um curto, que cabe inteiro na barra. Os estilos ficam em paginas.css (.janela-grande).
interface Props { perfil: "morador" | "profissional" | "conselho" | "portaria"; grande?: boolean; }
const { perfil, grande = false } = Astro.props;
const nome = { morador: "Carlos", profissional: "Marina", conselho: "Rita", portaria: "Jorge" }[perfil];
type Tom = "vermelho" | "ambar" | "violeta" | "verde";
const icones: Record<Tom, { fundo: string; cor: string; svg: string }> = {
  vermelho: { fundo: "#fff0f4", cor: "#bc1450", svg: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v5l3 2"/>' },
  ambar: { fundo: "#fff6e6", cor: "#95560a", svg: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/>' },
  violeta: { fundo: "#f8f3ff", cor: "#5808cc", svg: '<path d="M5 12.5l4.5 4.5L19 7"/>' },
  verde: { fundo: "#edfaf5", cor: "#0b7558", svg: '<rect x="4" y="5" width="16" height="15" rx="3"/><path d="M4 10h16M9 3v4M15 3v4"/>' },
};
const agora: Record<Props["perfil"], { tom: Tom; titulo: string; detalhe: string; selo: string; acao: string }[]> = {
  morador: [
    { tom: "vermelho", titulo: "1 retorno vencido", detalhe: "2026-0405 · portão da garagem · venceu às 11:00", selo: "Vencido", acao: "Dar retorno" },
    { tom: "ambar", titulo: "1 pedido sem responsável", detalhe: `${protocolo} · ninguém cuida dele ainda`, selo: "Atenção", acao: "Atribuir" },
  ],
  profissional: [
    { tom: "vermelho", titulo: "Residencial Ipê: 1 retorno vencido", detalhe: "2026-0405 · portão da garagem", selo: "Vencido", acao: "Dar retorno" },
    { tom: "ambar", titulo: "Ed. Araucária: 2 vencem hoje", detalhe: "2026-0118 e 2026-0121", selo: "Hoje", acao: "Ver" },
  ],
  conselho: [
    { tom: "violeta", titulo: "1 decisão esperando você", detalhe: "Qual encanador chamar · 2 orçamentos", selo: "Para você", acao: "Decidir" },
    { tom: "verde", titulo: "Pedidos do mês", detalhe: "18 concluídos · 3 em andamento", selo: "Em dia", acao: "Ver" },
  ],
  portaria: [
    { tom: "violeta", titulo: "Registrar pedido", detalhe: "Com foto, na hora, para a fila do síndico", selo: "Novo", acao: "Registrar" },
    { tom: "verde", titulo: "Encanador no apto 101", detalhe: "14:00 · visita técnica", selo: "Hoje", acao: "Ver" },
  ],
};
---
<div class:list={["janela", grande && "janela-grande"]} aria-hidden="true">
  <BarraPainel busca={grande ? "Buscar pedido" : undefined} />
  <div class="inicio-corpo">
    <div class="resumo"><small>Sexta-feira, 23 de outubro</small><b>Bom dia, {nome}</b><span>Residencial Ipê · Brasília</span></div>
    <div class="app-cartao agora-cartao">
      <div class="app-sub"><h4>Agora</h4><span class="ver-tudo">Ver tudo</span></div>
      {agora[perfil].map((a) => (
        <div class="agora-l">
          <span class="ic" style={`background:${icones[a.tom].fundo};color:${icones[a.tom].cor}`}><svg viewBox="0 0 24 24" set:html={icones[a.tom].svg} /></span>
          <span class="t">{a.titulo}<small>{a.detalhe}</small></span>
          <span class:list={["pil", a.tom]}>{a.selo}</span>
          <span class="app-bt">{a.acao}</span>
        </div>
      ))}
    </div>
  </div>
</div>
