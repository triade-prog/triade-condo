---
// A chamada final sobre a foto dos prédios à noite, com o formulário de demonstração dentro dela.
// No celular, para a página não ficar longa, o formulário dá lugar a dois botões: a página do formulário e o WhatsApp.
import Destaque from "./Destaque.astro";
import SimboloMonta from "./SimboloMonta.astro";
import FormularioDemonstracao from "./FormularioDemonstracao.astro";
import { duracaoDemonstracao, promessaRetorno, linkWhatsapp } from "../dados/empresa";
const zap = linkWhatsapp("Olá! Quero ver uma demonstração da TRÍADE Condo.");
---
<section class="final2 ancora" id="pedir">
  <div class="wrap">
    <div>
      <SimboloMonta />
      <h2 class="titulo-g" style="color:#fff;max-width:11em">Veja um pedido do seu prédio <Destaque semTraco>no painel</Destaque></h2>
      <p class="lead2" style="margin-top:16px">Demonstração de {duracaoDemonstracao}, por vídeo ou na reunião do condomínio. Sem compromisso.</p>
      <ol>
        <li><span class="mono-d">1</span>Você manda os quatro dados ao lado.</li>
        <li><span class="mono-d">2</span>Respondemos pelo WhatsApp {promessaRetorno}.</li>
        <li><span class="mono-d">3</span>Registramos um pedido real do seu prédio e acompanhamos com você.</li>
      </ol>
      <div class="final-cel">
        <a href="/demonstracao" class="botao branco">Solicitar demonstração</a>
        {zap && <a href={zap} class="botao contorno-claro">Falar pelo WhatsApp</a>}
        <p>Respondemos pelo WhatsApp {promessaRetorno}.</p>
      </div>
    </div>
    <FormularioDemonstracao />
  </div>
</section>
