---
// O único momento de violeta profundo, com a pirâmide do símbolo.
import { duracaoDemonstracao, linkWhatsapp } from "../dados/empresa";
interface Props { titulo?: string; texto?: string; }
const { titulo = "Veja um pedido do início ao fim, no seu prédio", texto = `${duracaoDemonstracao[0].toUpperCase()}${duracaoDemonstracao.slice(1)}, por vídeo ou na reunião do condomínio. Sem compromisso.` } = Astro.props;
const whatsapp = linkWhatsapp("Olá! Quero conhecer a TRÍADE Condo.");
---
<section class="faixa-final">
  <div class="piramide" aria-hidden="true"><span class="base"></span><i></i><i></i><i></i></div>
  <div class="wrap secao pilha" style="--gap:18px;position:relative">
    <h2 style="max-width:620px;font-size:clamp(28px,4vw,46px)">{titulo}</h2>
    <p style="font-size:18px;max-width:540px">{texto}</p>
    <div class="linha-flex" style="margin-top:8px">
      <a href="/demonstracao" class="botao laranja">Agendar demonstração</a>
      {whatsapp && <a href={whatsapp} class="botao contorno-claro">Falar no WhatsApp</a>}
    </div>
  </div>
</section>
