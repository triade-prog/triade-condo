---
import { cidade, cnpj, enderecoPlataforma, razaoSocial } from "../dados/empresa";
const identificacao = [razaoSocial, cnpj && `CNPJ ${cnpj}`].filter(Boolean).join(" · ");
---
<footer class="rodape" id="rodape">
  <div class="wrap">
    <div class="pilha" style="--gap:12px">
      <a href="/" class="marca" aria-label="TRÍADE Condo, início"><img src="/logo-triade-240.webp" alt="TRÍADE Condo" width="95" height="30" loading="lazy" /></a>
      <p class="suave" style="font-size:14px">Organiza o atendimento e a rotina de condomínios. {cidade}.</p>
      {identificacao && <p class="suave" style="font-size:13px">{identificacao}</p>}
    </div>
    <div class="pilha" style="--gap:8px"><b>Produto</b><a href="/plataforma">Plataforma</a><a href="/solucoes">Soluções</a><a href="/como-funciona">Como funciona</a><a href="/solucoes#implantacao">Implantação</a><a href="/precos">Preços</a><a href="/demonstracao">Agendar demonstração</a></div>
    <div class="pilha" style="--gap:8px"><b>Guia do síndico</b><a href="/guia">Organizar os pedidos sem virar refém do grupo</a><a href="/guia">O que entregar ao próximo síndico</a><a href="/guia">Preventivas pela NBR 5674</a></div>
    <div class="pilha" style="--gap:8px"><b>Legal</b><a href="/privacidade">Política de privacidade deste site</a><a href={enderecoPlataforma}>Entrar na Plataforma</a></div>
  </div>
</footer>
