---
// A implantação presencial em uma faixa: a foto da equipe inteira, com o texto por cima.
import Destaque from "./Destaque.astro";
---
<section class="gente ancora">
  <figure class="gente-foto">
    <img src="/encontro-1400.webp" srcset="/encontro-800.webp 800w, /encontro-1400.webp 1400w" sizes="100vw" loading="lazy" width="1400" height="933" alt="Síndica com um tablet conversa com uma moradora e um prestador no jardim do condomínio, ao fim da tarde." />
  </figure>
  <div class="wrap gente-texto">
    <div>
      <h2 class="titulo-g">Gente de verdade <Destaque semTraco>do seu lado</Destaque></h2>
      <p class="lead2">Em Brasília e no DF, a equipe da TRÍADE apresenta o sistema na reunião do condomínio, cadastra o prédio com você e deixa o WhatsApp funcionando.</p>
      <a href="/solucoes#implantacao" class="botao claro">Como é a implantação</a>
    </div>
  </div>
</section>
