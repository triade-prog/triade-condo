  <span class="brilho"></span>
</div>

<script>
  const simbolos = document.querySelectorAll<HTMLElement>(".simbolo-monta");
  if (matchMedia("(prefers-reduced-motion: no-preference)").matches && "IntersectionObserver" in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("montar"); io.unobserve(e.target); } }), { threshold: 0.6 });
    simbolos.forEach((s) => { s.classList.add("armado"); io.observe(s); });
  }
</script>
