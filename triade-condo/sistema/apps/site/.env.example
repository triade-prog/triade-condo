# Site da TRÍADE Condo. Copie para .env (local) ou grave no projeto da Vercel.
# Endereço público do site (canônico, sitemap e Open Graph).
SITE_URL=https://www.triadecondo.com.br
# WhatsApp comercial, só dígitos com DDI e DDD. Sem ele, vale o número em src/dados/empresa.ts.
PUBLIC_WHATSAPP_COMERCIAL=
# Razão social e CNPJ do rodapé (EM-01). Sem eles, o rodapé mostra só "TRÍADE · Brasília, DF".
PUBLIC_RAZAO_SOCIAL=
PUBLIC_CNPJ=
# Envio dos pedidos de demonstração por e-mail, pelo Resend (o mesmo do sistema, DC12).
RESEND_API_KEY=
LEADS_EMAIL_DE=TRÍADE Condo <site@triadecondo.com.br>
LEADS_EMAIL_PARA=
